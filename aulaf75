#!/usr/bin/env bash
# Launcher: runs the CLI with the project venv, no activation needed.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"
if [ -x "$HERE/.venv/bin/python" ]; then
    exec "$HERE/.venv/bin/python" -m aula "$@"
else
    exec python3 -m aula "$@"
fi
